# Copy to backend/.env (the API and worker read it) — frontend vars go in frontend/.env

# ─── LLM ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Groq retired the Llama 3 models; these defaults are the gpt-oss models.
# /api/v1/ready reports an error if a configured model is not available to your key.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# ─── Tools ──────────────────────────────────────────────────────────────────
# Optional — without it the web-search toggle is disabled and answers use papers only
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Services ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── Database (optional – for session history) ───────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./research.db

# ─── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=dev-secret-key-change-in-prod
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Retrieval tuning (optional) ────────────────────────────────────────────
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_TOP_N=5
# RERANK_MIN_SCORE=0.05
# MAX_SOURCES=10
# FOLLOW_UPS_ENABLED=true

# ─── LangSmith tracing (optional but recommended) ───────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-assistant

# ─── Frontend (frontend/.env) ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-secret-key-change-in-prod
