# ─── LLM ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Tools ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Services ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── Database (optional – for session history) ───────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./research.db

# ─── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=dev-secret-key-change-in-prod

# ─── LangSmith tracing (optional but recommended) ───────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-assistant

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-secret-key-change-in-prod
